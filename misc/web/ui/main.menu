#include "ui/menudef.h"
#include "ui/menumacros.h"

#define WINDOW_X 16
#define WINDOW_Y 16
#define WINDOW_WIDTH 208
#define WINDOW_HEIGHT 144
#define GROUP_NAME "grpMain"

// Recovery after a native disconnect uses the browser launcher for matchmaking.
menuDef {
    name "main_opener"
    visible 0
    fullscreen 0
    rect WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
    onOpen {
        open fadebox_black ; open background_1 ;
        setmenuitemcolor fadebox_black fadebox backcolor 0 0 0 1 ;
        fadeoutmenu fadebox_black ; open main ; close main_opener
    }
}

menuDef {
    name "main"
    visible 0
    fullscreen 0
    rect WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
    style WINDOW_STYLE_FILLED
    onOpen { clearFocus }
    onEsc { uiScript browserMatchSetup }
    WINDOW(_("ENEMY TERRITORY"), 50)
    BUTTON(6, 32, WINDOW_WIDTH-12, 18, _("MATCH SETUP"), .3, 14, uiScript browserMatchSetup)
    BUTTON(6, 56, WINDOW_WIDTH-12, 18, _("MSGID_MENU_INGAME_OPTIONS"), .3, 14, close main ; open options)
    BUTTON(6, 80, WINDOW_WIDTH-12, 18, _("MSGID_MENU_OPTION_CONTROLS"), .3, 14, close main ; open options_controls)
    BUTTON(6, 104, WINDOW_WIDTH-12, 18, _("MSGID_MENU_INGAME_CHANGELOG"), .3, 14, setcvar ui_changelog_ingame 0 ; close main ; open changelog_popup)
}
