/* The entire engine bundle is verified before activation. Packs live in IDBFS. */
'use strict';
const VERSION = '@PWA_VERSION@';
const CORE = [@PWA_ENTRIES@];
const base = new URL('./', self.location.href);
const PREFIX = 'etl-app-' + encodeURIComponent(base.pathname) + '-';
const CACHE = PREFIX + VERSION;
const absolute = path => new URL(path, base).href;
function appClient(client) {
 // includeUncontrolled also returns unrelated pages hosted on this origin.
 // Only launcher/game and recovery pages participate in app update handling.
 try {
  const url = new URL(client.url);
  return url.origin === base.origin && [base.pathname,
   new URL('etl.html', base).pathname, new URL('network/recovery', base).pathname].includes(url.pathname);
 } catch (error) { return false; }
}
async function verifiedResponse(response, entry, progress) {
 if (!response || !response.ok || response.status !== 200 || response.type === 'opaque' || response.redirected) return false;
 const copy = response.clone();
 let bytes;
 if (copy.body && copy.body.getReader) {
  // Published decoded sizes bound allocation and streamed reads, including gzip.
  bytes = new Uint8Array(entry.size);
  const reader = copy.body.getReader(); let loaded = 0;
  try {
   while (true) {
    const chunk = await reader.read();
    if (chunk.done) break;
    if (chunk.value.byteLength > entry.size - loaded) { reader.cancel().catch(() => {}); if (response.body) response.body.cancel().catch(() => {}); return false; }
    bytes.set(chunk.value, loaded); loaded += chunk.value.byteLength;
    if (progress && chunk.value.byteLength) progress(loaded);
   }
  } finally { reader.releaseLock(); }
  if (loaded !== entry.size) return false;
 } else {
  bytes = new Uint8Array(await copy.arrayBuffer());
  if (bytes.byteLength !== entry.size) return false;
  if (progress) progress(bytes.byteLength);
 }
 const hash = Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256', bytes)), b => b.toString(16).padStart(2,'0')).join('');
 return hash === entry.sha256;
}
let repairInFlight = null, repairProgress = null, repairReportedAt = 0;
const repairSubscribers = new Set();
function repairBundle(client, requestId) {
 const notify = value => { try { client.postMessage({type:'APP_SAVE_PROGRESS', requestId, ...value}); } catch (error) {} };
 repairSubscribers.add(notify);
 if (!repairInFlight) {
  repairProgress = null; repairReportedAt = 0;
  repairInFlight = installBundle(true, value => {
   repairProgress = value;
   const now = performance.now();
   if (repairReportedAt && now - repairReportedAt < 250 && value.loaded !== value.total) return;
   repairReportedAt = now; repairSubscribers.forEach(subscriber => subscriber(value));
  }).finally(() => { repairInFlight = null; repairProgress = null; });
 } else if (repairProgress) notify(repairProgress);
 return repairInFlight.finally(() => { repairSubscribers.delete(notify); });
}
async function installBundle(repair = false, progress) {
 const cache = await caches.open(CACHE), total = CORE.reduce((sum, entry) => sum + entry.size, 0);
 let completed = 0, highest = 0;
 try {
  const previous = [];
  if (!repair) {
   const keys = (await caches.keys()).filter(key => key.startsWith(PREFIX) && key !== CACHE).reverse().slice(0, 8);
   for (const key of keys) {
    try { previous.push(await caches.open(key)); } catch (error) { /* Evicted old caches cannot block an update. */ }
   }
  }
  for (const entry of CORE) {
   const advancing = loaded => {
    const value = completed + loaded;
    if (progress && value > highest) { highest = value; progress({loaded:value, total}); }
   };
   if (repair) {
    const saved = await cache.match(absolute(entry.url));
    try { if (await verifiedResponse(saved, entry)) { advancing(entry.size); completed += entry.size; continue; } }
    catch (error) { /* Unreadable saved bytes must be downloaded and verified again. */ }
   }
   if (!repair) {
    let reused = false;
    for (const older of previous) {
     let saved;
     try { saved = await older.match(absolute(entry.url)); if (!await verifiedResponse(saved, entry)) continue; }
     catch (error) { continue; }
     // Copy verified bytes into the staged version; never edit the active cache.
     await cache.put(absolute(entry.url), saved); reused = true; break;
    }
    if (reused) { completed += entry.size; continue; }
   }
   const response = await fetch(absolute(entry.url), {cache:'reload', credentials:'same-origin'});
   if (!await verifiedResponse(response, entry, progress ? advancing : null)) throw Error('App download failed or bundle changed');
   await cache.put(absolute(entry.url), response); completed += entry.size;
  }
 } catch (error) { if (!repair) await caches.delete(CACHE); throw error; }
}
async function status(client, requestId) {
 try {
  const cache = await caches.open(CACHE);
  const entries = await Promise.all(CORE.map(entry => cache.match(absolute(entry.url))));
  client.postMessage({type:entries.every(Boolean) ? 'APP_READY' : 'APP_MISSING', version:VERSION, ...(requestId === undefined ? {} : {requestId})});
 } catch (error) { client.postMessage({type:'APP_SAVE_FAILED', version:VERSION, ...(requestId === undefined ? {} : {requestId})}); }
}
function recoveryPage() {
 // This small page can repair an evicted bundle even when the launcher itself is missing.
 return new Response(@PWA_RECOVERY_JSON@, {status:503, headers:{'Content-Type':'text/html; charset=utf-8', 'Cross-Origin-Opener-Policy':'same-origin', 'Cross-Origin-Embedder-Policy':'require-corp', 'Cache-Control':'no-store'}});
}
self.addEventListener('install', event => event.waitUntil(installBundle()));
self.addEventListener('activate', event => event.waitUntil((async () => {
 // A waiting update activates only after old tabs close or an explicit reload.
 const clients = (await self.clients.matchAll({type:'window', includeUncontrolled:true})).filter(appClient);
 clients.forEach(client => client.postMessage({type:'APP_READY', version:VERSION}));
 for (const key of await caches.keys()) if (key.startsWith(PREFIX) && key !== CACHE) await caches.delete(key);
 // The first install takes control on the next navigation, preserving in-flight startup.
})()));
self.addEventListener('message', event => {
 if (event.data && event.data.type === 'ACTIVATE_UPDATE') event.waitUntil((async () => {
  const clients = (await self.clients.matchAll({type:'window', includeUncontrolled:true})).filter(appClient);
  if (clients.length > 1) { if (event.source) event.source.postMessage({type:'APP_OTHER_TABS'}); return; }
  await self.skipWaiting();
 })());
 if (event.data && event.data.type === 'APP_STATUS' && event.source) event.waitUntil(status(event.source));
 if (event.data && event.data.type === 'REPAIR_CACHE' && event.source) event.waitUntil((async () => {
  try { await repairBundle(event.source, event.data.requestId); await status(event.source, event.data.requestId); }
  catch (e) { event.source.postMessage({type:'APP_SAVE_FAILED', ...(event.data.requestId === undefined ? {} : {requestId:event.data.requestId})}); }
 })());
});
self.addEventListener('fetch', event => {
 const request = event.request, url = new URL(request.url);
 if (request.method !== 'GET' || url.origin !== base.origin || request.headers.has('range')) return;
 const navigation = request.mode === 'navigate' && (url.pathname === base.pathname || url.pathname === new URL('etl.html',base).pathname);
 const entry = navigation ? CORE[0] : CORE.find(item => new URL(item.url,base).pathname === url.pathname);
 // Relay configuration, game packs, manifests and unknown paths remain live requests.
 if (!entry) return;
 event.respondWith((async () => {
  try {
   const cache = await caches.open(CACHE);
   if (navigation && !(await Promise.all(CORE.map(item => cache.match(absolute(item.url))))).every(Boolean)) return recoveryPage();
   const cached = await cache.match(absolute(entry.url));
   if (cached) return cached;
  } catch (error) { /* Storage denial uses the same recoverable screen. */ }
  if (navigation) return recoveryPage();
  // Fail closed rather than mixing unverified new engine files into an old page.
  return new Response('Offline app files are unavailable. Reconnect and reload to save the app again.', {status:503, headers:{'Content-Type':'text/plain'}});
 })());
});
